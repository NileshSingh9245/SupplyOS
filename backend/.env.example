# Shape reference only. Generate a private file with tools/init_env.py.
APP_ENV=development
FREE_ONLY_MODE=true
# Enable only after verifying the account's free allowance, hard limits and delivery quality.
APPROVED_FREE_SMTP=false
SETUP_AUTHORIZATION_TOKEN=
API_V1_PREFIX=/api/v1
DATABASE_URL=
DATABASE_URL_SYNC=
REDIS_URL=
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
COOKIE_SAMESITE=lax
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5-20250929

# Opt-in only. Use an owner-authorized sender and relay; no account is provisioned here.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SupplyOS
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10
# One canonical public page, not the FRONTEND_URL CORS list. HTTPS in staging/production.
PASSWORD_RESET_URL=
PASSWORD_RESET_CAPACITY=4
PASSWORD_RESET_WINDOW_SECONDS=3600
PASSWORD_RESET_MAX_REQUESTS_PER_IP=3
PASSWORD_RESET_MAX_REQUESTS_PER_IDENTITY=3
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_RATE_LIMIT_TIMEOUT_SECONDS=0.5
PASSWORD_RESET_WORK_TIMEOUT_SECONDS=10

# Explicit private proof storage selection. Credentials never belong in a public client.
PROOF_STORAGE_BACKEND=local
APPROVED_FREE_STORAGE=false
# Keep false until deployed REST version selectors and retained-version policy are verified.
SUPABASE_VERSIONING_VERIFIED=false
SUPABASE_STORAGE_ORIGIN=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_KEY=
PROOF_STORAGE_TIMEOUT_SECONDS=10
PROOF_STORAGE_CAPACITY=4
