# Server-only origin used by Next.js for the same-origin /api proxy.
# Do not append /api/v1. Restart Next.js after changing routing configuration.
BACKEND_URL=http://127.0.0.1:8001
NEXT_PUBLIC_API_BASE=/api/v1

# Optional public origin overrides for a deliberately configured cross-origin API.
# These values are exposed to browsers. Never put credentials or secrets here.
NEXT_PUBLIC_BACKEND_URL=
REACT_APP_BACKEND_URL=

# Optional isolated Next.js output for local verification.
# NEXT_DIST_DIR=.runtime/next
